@using Microsoft.AspNetCore.Identity
@using TumicseSite.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center gap-lg-2 site-auth">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link site-nav__link site-auth__user" asp-area="Identity" asp-page="/Account/Manage/Index" title="Gerenciar conta">
            @User.Identity?.Name
        </a>
    </li>
    <li class="nav-item">
        <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn btn-link nav-link site-nav__link site-auth__logout">Sair</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link site-nav__link" asp-area="Identity" asp-page="/Account/Register">Cadastro</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-brand-outline site-auth__login" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
    </li>
}
</ul>
