@model AgendaIndexViewModel
@{
    ViewData["Title"] = "Agenda Interna";
}

@section Styles {
    <link rel="stylesheet" href="~/css/agenda.css" asp-append-version="true" />
}

<section class="agenda-page agenda-page--internal">
    <div class="agenda-hero">
        <div class="container">
            <div class="agenda-hero__panel agenda-hero__panel--internal">
                <span class="agenda-hero__eyebrow">@Model.Eyebrow</span>
                <div class="agenda-hero__content">
                    <div>
                        <h1 class="agenda-hero__title">@Model.Title</h1>
                        <p class="agenda-hero__subtitle">@Model.Subtitle</p>
                    </div>
                    <div class="agenda-hero__summary">
                        <span class="agenda-hero__pill">@Model.EventCount compromisso@(Model.EventCount == 1 ? string.Empty : "s") futuro@(Model.EventCount == 1 ? string.Empty : "s")</span>
                        <span class="agenda-hero__pill agenda-hero__pill--soft">Publicos e internos para Admin e Medium</span>
                    </div>
                    <div class="agenda-hero__actions">
                        <a class="btn btn-brand-primary" asp-controller="Membros" asp-action="Index">Area de membros</a>
                        <a class="btn btn-brand-secondary" asp-action="Index">Ver agenda publica</a>
                        @if (User.IsInRole(TumicseSite.Data.IdentityRoles.Admin))
                        {
                            <a class="btn btn-brand-outline" asp-area="Admin" asp-controller="Eventos" asp-action="Index">Gerenciar eventos</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        @if (Model.Months.Count > 0)
        {
            <div class="agenda-months">
                @foreach (var month in Model.Months)
                {
                    <section class="agenda-month">
                        <div class="agenda-month__header">
                            <span class="agenda-month__eyebrow">Planejamento da casa</span>
                            <h2 class="agenda-month__title">@month.MonthLabel</h2>
                        </div>

                        <div class="agenda-card-grid">
                            @foreach (var item in month.Events)
                            {
                                <article class="agenda-card @(item.IsPublic ? "is-public" : "is-internal") @(item.IsCancelled ? "is-cancelled" : string.Empty)">
                                    <div class="agenda-card__date">
                                        <span class="agenda-card__day">@item.DayLabel</span>
                                        <span class="agenda-card__month">@item.MonthShortLabel</span>
                                    </div>

                                    <div class="agenda-card__body">
                                        <div class="agenda-card__meta">
                                            <span>@item.WeekdayLabel</span>
                                            <span>@item.TimeLabel</span>
                                        </div>

                                        <div class="agenda-card__badges">
                                            <span class="agenda-badge agenda-badge--type">@item.EventType</span>
                                            <span class="agenda-badge @(item.IsPublic ? "agenda-badge--public" : "agenda-badge--internal")">
                                                @(item.IsPublic ? "Publico" : "Interno")
                                            </span>
                                            @if (item.IsCancelled)
                                            {
                                                <span class="agenda-badge agenda-badge--cancelled">Cancelado</span>
                                            }
                                        </div>

                                        <h3 class="agenda-card__title">@item.Title</h3>

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <p class="agenda-card__text">@item.Description</p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.Location))
                                        {
                                            <p class="agenda-card__location">Local: @item.Location</p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.InternalNotes))
                                        {
                                            <div class="agenda-card__notes">
                                                <span class="agenda-card__notes-label">Observacoes internas</span>
                                                <p>@item.InternalNotes</p>
                                            </div>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }
            </div>
        }
        else
        {
            <section class="agenda-empty">
                <div class="agenda-empty__panel">
                    <span class="agenda-empty__eyebrow">@Model.Eyebrow</span>
                    <h2 class="agenda-empty__title">@Model.EmptyTitle</h2>
                    <p class="agenda-empty__text">@Model.EmptyMessage</p>
                </div>
            </section>
        }
    </div>
</section>
