@model AdminEventosIndexViewModel
@{
    ViewData["Title"] = "Admin - Eventos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/agenda.css" asp-append-version="true" />
}

<section class="admin-shell">
    <div class="admin-shell__header">
        <span class="admin-shell__eyebrow">Administracao</span>
        <h1 class="admin-shell__title">Gerenciar agenda</h1>
        <p class="admin-shell__subtitle">Cadastre, edite e acompanhe os eventos publicos e internos do TUMICSE sem perder o contexto da casa.</p>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="alert admin-status mb-0" role="status">@statusMessage</div>
    }

    <div class="admin-shell__actions">
        <a class="btn btn-brand-primary" asp-action="Create">Novo evento</a>
        <a class="btn btn-brand-secondary" asp-area="Admin" asp-controller="Aulas" asp-action="Index">Aulas</a>
        <a class="btn btn-brand-outline" asp-area="" asp-controller="Agenda" asp-action="Index">Agenda publica</a>
        <a class="btn btn-brand-outline" asp-area="" asp-controller="Agenda" asp-action="Interna">Agenda interna</a>
    </div>

    <form method="get" class="agenda-admin-filters">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="period" class="form-label">Periodo</label>
                <select id="period" name="period" asp-items="Model.PeriodOptions" class="form-select"></select>
            </div>
            <div class="col-md-4">
                <label for="visibility" class="form-label">Visibilidade</label>
                <select id="visibility" name="visibility" asp-items="Model.VisibilityOptions" class="form-select"></select>
            </div>
            <div class="col-md-4">
                <label for="state" class="form-label">Estado</label>
                <select id="state" name="state" asp-items="Model.StateOptions" class="form-select"></select>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="submit" class="btn btn-brand-primary">Aplicar filtros</button>
            <a class="btn btn-brand-secondary" asp-action="Index">Limpar</a>
        </div>
    </form>

    <div class="admin-shell__table">
        @if (Model.Events.Count > 0)
        {
            <div class="table-responsive">
                <table class="table admin-table align-middle">
                    <thead>
                        <tr>
                            <th>Inicio</th>
                            <th>Titulo</th>
                            <th>Tipo</th>
                            <th>Visibilidade</th>
                            <th>Estado</th>
                            <th>Local</th>
                            <th class="text-end">Acoes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Events)
                        {
                            <tr>
                                <td>@item.StartsAtLabel</td>
                                <td>@item.Title</td>
                                <td>@item.EventType</td>
                                <td>
                                    <span class="agenda-badge @(item.IsPublic ? "agenda-badge--public" : "agenda-badge--internal")">
                                        @item.VisibilityLabel
                                    </span>
                                </td>
                                <td>
                                    <div class="agenda-admin-status">
                                        @if (item.IsActive && !item.IsCancelled)
                                        {
                                            <span class="agenda-badge agenda-badge--active">Ativo</span>
                                        }
                                        @if (!item.IsActive)
                                        {
                                            <span class="agenda-badge agenda-badge--inactive">Inativo</span>
                                        }
                                        @if (item.IsCancelled)
                                        {
                                            <span class="agenda-badge agenda-badge--cancelled">Cancelado</span>
                                        }
                                    </div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.Location) ? "-" : item.Location)</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2 flex-wrap justify-content-end">
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="admin-shell__panel">
                <h2 class="admin-shell__title h4">Nenhum evento encontrado.</h2>
                <p class="admin-shell__subtitle">Ajuste os filtros acima ou cadastre o primeiro evento da agenda.</p>
            </div>
        }
    </div>
</section>
