@model AdminLessonVideoFormViewModel
@{
    ViewData["Title"] = "Admin - Nova Aula";
}

@section Styles {
    <link rel="stylesheet" href="~/css/aulas.css" asp-append-version="true" />
}

<section class="admin-shell">
    <div class="admin-shell__header">
        <span class="admin-shell__eyebrow">Administracao</span>
        <h1 class="admin-shell__title">Cadastrar aula</h1>
        <p class="admin-shell__subtitle">Informe os dados da aula e vincule o video do YouTube a uma categoria existente.</p>
    </div>

    <form asp-action="Create" method="post" class="admin-form">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="VideoCategoryId" class="form-label"></label>
            <select asp-for="VideoCategoryId" asp-items="Model.Categories" class="form-select">
                <option value="">Selecione uma categoria</option>
            </select>
            <span asp-validation-for="VideoCategoryId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="YouTubeReference" class="form-label"></label>
            <input asp-for="YouTubeReference" class="form-control" />
            <div class="admin-hint mt-2">Aceita a URL completa do YouTube ou apenas o <code>YouTubeVideoId</code>.</div>
            <span asp-validation-for="YouTubeReference" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="DisplayOrder" class="form-label"></label>
            <input asp-for="DisplayOrder" class="form-control" />
            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-brand-primary">Salvar aula</button>
            <a class="btn btn-brand-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
