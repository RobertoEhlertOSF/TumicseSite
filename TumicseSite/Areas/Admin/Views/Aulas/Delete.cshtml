@model AdminLessonVideoDeleteViewModel
@{
    ViewData["Title"] = "Admin - Excluir Aula";
}

@section Styles {
    <link rel="stylesheet" href="~/css/aulas.css" asp-append-version="true" />
}

<section class="admin-shell">
    <div class="admin-shell__header">
        <span class="admin-shell__eyebrow">Administracao</span>
        <h1 class="admin-shell__title">Excluir aula</h1>
        <p class="admin-shell__subtitle">Confirme a exclusao apenas se o video nao deve mais aparecer para os mediuns.</p>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="admin-delete">
        <dl>
            <div>
                <dt>Titulo</dt>
                <dd>@Model.Title</dd>
            </div>
            <div>
                <dt>Categoria</dt>
                <dd>@Model.CategoryName</dd>
            </div>
            <div>
                <dt>YouTubeVideoId</dt>
                <dd><code>@Model.YouTubeVideoId</code></dd>
            </div>
            <div>
                <dt>Ordem de exibicao</dt>
                <dd>@Model.DisplayOrder</dd>
            </div>
        </dl>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-danger">Excluir aula</button>
            <a class="btn btn-brand-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</section>
