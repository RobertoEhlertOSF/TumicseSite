@model AdminVideoCategoryFormViewModel
@{
    ViewData["Title"] = "Admin - Editar Categoria";
}

@section Styles {
    <link rel="stylesheet" href="~/css/aulas.css" asp-append-version="true" />
}

<section class="admin-shell">
    <div class="admin-shell__header">
        <span class="admin-shell__eyebrow">Administracao</span>
        <h1 class="admin-shell__title">Editar categoria</h1>
        <p class="admin-shell__subtitle">Atualize o nome e a ordem de exibicao da categoria selecionada.</p>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-form">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="DisplayOrder" class="form-label"></label>
            <input asp-for="DisplayOrder" class="form-control" />
            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-brand-primary">Salvar alteracoes</button>
            <a class="btn btn-brand-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
